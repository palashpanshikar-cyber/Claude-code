generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Category {
  ADVENTURE
  FOOD_DRINK
  CULTURE
  NATURE
  FITNESS
  CREATIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  // IANA zone. Streaks and mini rotation are evaluated in the user's own day.
  timezone     String   @default("UTC")
  city         String?
  /// Profile photo, stored as an object key like completions are.
  avatarKey    String?
  /// Moderation rights. Set by hand in the database — there is no endpoint
  /// that grants it, because nothing should be able to escalate itself.
  isAdmin      Boolean  @default(false)

  currentStreak Int @default(0)
  longestStreak Int @default(0)
  // Local calendar date (YYYY-MM-DD) of the most recent streak-qualifying day.
  lastActiveDay String?

  createdAt   DateTime @default(now())
  completions Completion[]
  miniAssignments MiniAssignment[]

  // Phase 2 surfaces these; the table exists now so the follow graph doesn't
  // need a migration against live data later.
  submittedQuests Quest[] @relation("questAuthor")
  following Follow[] @relation("follower")
  followers Follow[] @relation("followed")
  streakBreaks StreakBreak[]

  @@index([lastActiveDay])
}

/// Analytics: one row each time a streak is broken, written by the sweep job.
/// Answers "how far do people get before they drop off?".
model StreakBreak {
  id            String   @id @default(cuid())
  userId        String
  /// How long the streak was when it broke.
  streakLength  Int
  /// Last day the user was actually active, in their local calendar.
  lastActiveDay String?
  brokenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, brokenAt])
  @@index([brokenAt])
}

/// Objects whose owning row is gone, queued for removal from storage.
///
/// Deletion of an account must succeed even when object storage is unreachable
/// — otherwise a user who wants out cannot get out — so the bytes are cleaned
/// up asynchronously instead of inline.
model OrphanedObject {
  id        String   @id @default(cuid())
  objectKey String   @unique
  createdAt DateTime @default(now())
  attempts  Int      @default(0)

  @@index([createdAt])
}

/// Open follow model — no approval step, matching the product spec.
/// Unused in Phase 1.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId])
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  category    Category
  // Null city = an "everywhere" quest, available to every user.
  city        String?
  neighborhood String?
  // Rough effort in minutes, used for display and filtering.
  durationMin Int      @default(30)
  difficulty  Int      @default(1) // 1-3
  /// Moderation state. Seeded and admin-created quests are APPROVED; anything
  /// a user submits starts PENDING and is invisible until reviewed.
  status      QuestStatus @default(APPROVED)
  /// Null for seeded quests.
  createdById String?
  /// Soft disable, independent of moderation — retires a quest that was
  /// approved but is no longer doable (venue closed, season ended).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  createdBy   User?    @relation("questAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  completions Completion[]

  @@index([category, city])
  @@index([isActive])
  @@index([status, createdAt])
}

model Completion {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  photoKey  String
  review    String?
  rating    Int // 1-5
  // Local calendar date the completion counted for.
  localDay  String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Restrict)

  // One completion per quest per user — repeat logging would inflate streaks.
  @@unique([userId, questId])
  @@index([userId, createdAt])
  @@index([userId, localDay])
}

model MiniQuest {
  id       String   @id @default(cuid())
  // Stable position in the fixed rotation; drives which minis surface on a day.
  slot     Int      @unique
  title    String
  prompt   String
  category Category

  assignments MiniAssignment[]
}

model MiniAssignment {
  id          String    @id @default(cuid())
  userId      String
  miniQuestId String
  localDay    String
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniQuest MiniQuest @relation(fields: [miniQuestId], references: [id], onDelete: Cascade)

  @@unique([userId, miniQuestId, localDay])
  @@index([userId, localDay])
}
