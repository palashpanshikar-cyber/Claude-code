DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sidequest?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Cloudflare R2 (S3-compatible). Leave blank for local dev — photos saved to ./uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sidequest-uploads
# Set only if the bucket is public. Left blank, photo URLs are presigned per read.
R2_PUBLIC_URL=

# Set to "true" to run cron jobs in-process (Railway/Render)
ENABLE_CRON=true

# Local photo storage — used only when R2_ACCOUNT_ID is blank
UPLOAD_DIR=uploads
PUBLIC_BASE_URL="http://localhost:3000"

# Mobile dev server origin. "*" is fine until the app ships.
CORS_ORIGIN=*

# Seed content: the city/campus your city-tagged quests belong to
SEED_CITY="Boston"

# Used by `npm test`; defaults to a sidequest_test database on localhost
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sidequest_test?schema=public"
