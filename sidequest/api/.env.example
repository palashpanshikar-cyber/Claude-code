# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sidequest"

# Server
PORT=3000
NODE_ENV=development

# Auth — REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-before-deploying"
JWT_EXPIRES_IN=30d

# Scheduled jobs (streak sweep). Set to false on a second instance so the
# job only runs once.
RUN_CRON=true

# Seed content: the city/campus your city-tagged quests belong to.
SEED_CITY="Boston"

# Photo storage
# Leave R2_BUCKET unset to store photos on local disk under ./uploads.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL="http://localhost:3000"
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://photos.yourdomain.com
