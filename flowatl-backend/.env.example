# FlowATL backend configuration. Copy to .env and adjust.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Where the SQLite file lives. ":memory:" gives a fresh network every boot.
DATABASE_PATH=./data/flowatl.db

# Secret used to sign session tokens. MUST be set to a long random value
# outside of local development.
AUTH_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_HOURS=720

# Comma-separated list of allowed browser origins, or "*" for any.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Network simulation -------------------------------------------------
# Shuttles in service on the downtown loop.
FLEET_SIZE=6
# Vehicle capacity (seated + standing).
SHUTTLE_CAPACITY=12
# Cruising speed in downtown traffic.
SHUTTLE_SPEED_MPH=11
# Seconds a shuttle dwells at each stop for boarding/alighting.
STOP_DWELL_SECONDS=30
# Simulation tick interval in milliseconds.
TICK_MS=1000
# Speed multiplier — raise it to fast-forward a demo (e.g. 4 = 4x real time).
TIME_SCALE=1
# Deterministic seed for the ambient-demand generator.
SIM_SEED=20260920
