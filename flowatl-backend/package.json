{
  "name": "flowatl-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for FlowATL \u2014 AI-optimized autonomous electric shuttle network for downtown Atlanta.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test DATABASE_PATH=:memory: AUTH_SECRET=test-secret node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "cors": "^2.8.5",
    "express": "^5.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
